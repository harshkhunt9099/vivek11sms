<?xml version="1.0" encoding="utf-8"?>
<resources>

    <attr name="applyWindowInsets" format="boolean" />

    <declare-styleable name="MyAppBarLayout">
        <attr name="applyWindowInsets" />
    </declare-styleable>
    <attr name="autoAdjustToWithinGrandparentBounds" format="boolean"></attr>
    <attr name="autoCompleteBackgroundColor" format="reference|color"></attr>
    <attr name="iconColorState" format="reference|color"></attr>
    <attr name="iconColor" format="reference|color"></attr>
    <attr name="iconEndPadding" format="dimension"></attr>
    <attr name="autoCompleteTextViewStyle" format="reference"></attr>
    <attr name="autoCompleteTitleColor" format="reference|color"></attr>
    <attr name="autoCompleteUrlColor" format="reference|color"></attr>
    <declare-styleable name="CustomExpandableItemView">
        <attr name="headerText" format="string"></attr>
        <attr name="arrowIcon" format="reference"></attr>
        <attr name="animationDuration" format="integer"></attr>
    </declare-styleable>
    <declare-styleable name="SwipeRevealLayout">
        <attr name="dragEdge">
            <flag name="left" value="1" />
            <flag name="right" value="2" />
            <flag name="top" value="4" />
            <flag name="bottom" value="8" />
        </attr>
        <attr name="flingVelocity" format="integer"></attr>
        <attr name="mode">
            <enum name="normal" value="0" />
            <enum name="same_level" value="1" />
        </attr>
        <attr name="minDistRequestDisallowParent" format="dimension"></attr>

    </declare-styleable>
</resources>