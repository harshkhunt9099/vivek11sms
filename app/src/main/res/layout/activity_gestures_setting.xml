<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_app_bg"
    android:orientation="vertical"
    tools:context=".launcher.Codebizz_All_Activity.Codebizz_GesturesSettingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:padding="5dp"
            android:src="@drawable/lc_ic_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            android:fontFamily="@font/sfuitext_medium"
            android:includeFontPadding="false"
            android:text="@string/lc_gestures"
            android:textColor="@color/lc_txt_color"
            android:textSize="18sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lc_black_5" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="15dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llDoubleTap"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/lc_bg_home_screen_setting_item"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="15dp"
                    android:adjustViewBounds="true"
                    app:tint="@color/lc_ic_color"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_double_tap" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sfuitext_medium"
                        android:includeFontPadding="false"
                        android:text="@string/lc_double_tap"
                        android:textColor="@color/lc_txt_color"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDoubleTapAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/sfuitext_regular"
                        android:includeFontPadding="false"
                        android:text="@string/lc_do_nothing"
                        android:textColor="#979595"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="15dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_next_arrow_grey" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTapHold"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/lc_bg_home_screen_setting_item"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="15dp"
                    android:adjustViewBounds="true"
                    app:tint="@color/lc_ic_color"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_tap_hold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sfuitext_medium"
                        android:includeFontPadding="false"
                        android:text="@string/lc_tap_amp_hold"
                        android:textColor="@color/lc_txt_color"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTapAndHoldAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/sfuitext_regular"
                        android:includeFontPadding="false"
                        android:text="@string/lc_open_home_screen_pop_up"
                        android:textColor="#979595"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="15dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_next_arrow_grey" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHomeButton"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/lc_bg_home_screen_setting_item"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="15dp"
                    android:adjustViewBounds="true"
                    app:tint="@color/lc_ic_color"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_home_button" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sfuitext_medium"
                        android:includeFontPadding="false"
                        android:text="@string/lc_home_button"
                        android:textColor="@color/lc_txt_color"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHomeButtonAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/sfuitext_regular"
                        android:includeFontPadding="false"
                        android:text="@string/lc_do_nothing"
                        android:textColor="#979595"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="15dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_next_arrow_grey" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llBackButton"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginVertical="15dp"
                android:background="@drawable/lc_bg_home_screen_setting_item"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="15dp"
                    app:tint="@color/lc_ic_color"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_back_button_gestures" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sfuitext_medium"
                        android:includeFontPadding="false"
                        android:text="@string/lc_back_button"
                        android:textColor="@color/lc_txt_color"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBackButtonAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/sfuitext_regular"
                        android:includeFontPadding="false"
                        android:text="@string/lc_do_nothing"
                        android:textColor="#979595"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="15dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_next_arrow_grey" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/nativeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp" />

</LinearLayout>