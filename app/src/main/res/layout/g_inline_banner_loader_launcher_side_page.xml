<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    android:layout_centerInParent="true"
    android:background="@drawable/lc_bg_ads_inline_banner_launcher_side_page"
    android:gravity="center"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:textDirection="ltr">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_container_native"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="@color/native_shimmer_color">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/lightTransparent"
                android:orientation="vertical"
                android:paddingTop="5dip"
                android:paddingBottom="5.0dip" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_5sdp"
                android:background="@drawable/lc_g_rounded_corners_shape_custom"
                android:backgroundTint="#f4b400"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="AD"
                android:textColor="@color/gnt_white"
                android:textSize="11sp" />
        </RelativeLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</LinearLayout>