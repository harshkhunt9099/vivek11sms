<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_app_bg"
    android:orientation="vertical"
    tools:context=".launcher.Codebizz_All_Activity.Codebizz_WallpaperListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:padding="5dp"
            android:src="@drawable/lc_ic_back"
            app:tint="@color/lc_ic_color" />

        <TextView
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            android:fontFamily="@font/sfuitext_medium"
            android:includeFontPadding="false"
            android:text="@string/lc_wallpaper"
            android:textColor="@color/lc_txt_color"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="15dp"
            android:fontFamily="@font/sfuitext_medium"
            android:includeFontPadding="false"
            android:text="@string/lc_remaining"
            android:textColor="@color/lc_subtext_color"
            android:textSize="12sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lc_black_5" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tlCategory"
        android:layout_width="match_parent"
        android:layout_height="37dp"
        android:layout_marginVertical="15dp"
        android:background="@color/lc_app_bg"
        app:tabBackground="@drawable/lc_tab_selector"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabMode="auto"
        app:tabRippleColor="@null"
        app:tabSelectedTextAppearance="@style/SelectedTabTextStyle"
        app:tabSelectedTextColor="@color/lc_tab_selected_text_color"
        app:tabTextAppearance="@style/TabTextStyle"
        app:tabTextColor="@color/lc_tab_unselected_text_color" />

    <androidx.viewpager2.widget.ViewPager2
        android:layout_weight="1"
        android:id="@+id/vpWallpaper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/lc_app_bg" />

    <FrameLayout
        android:id="@+id/nativeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp" />

</LinearLayout>