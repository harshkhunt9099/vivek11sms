<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/lc_small_margin"
    android:paddingTop="@dimen/lc_medium_margin"
    android:paddingEnd="@dimen/lc_small_margin"
    android:paddingBottom="@dimen/lc_small_margin">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/launcher_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:shapeAppearance="@style/CornerRadius" />

    <TextView
        android:id="@+id/launcher_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/sfuitext_regular"
        android:gravity="center|top"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textSize="@dimen/lc_smaller_text_size" />

    <View
        android:id="@+id/popup_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp" />

</LinearLayout>