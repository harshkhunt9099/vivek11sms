<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="horizontal">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/lc_white"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:paddingVertical="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:paddingVertical="15dp"
                android:paddingHorizontal="20dp"
                android:id="@+id/tvSetAsLockScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfuitext_medium"
                android:includeFontPadding="false"
                android:text="@string/lc_set_as_lock_screen"
                android:textColor="@color/lc_black"
                android:textSize="16sp" />

            <TextView
                android:paddingHorizontal="20dp"
                android:paddingVertical="15dp"
                android:id="@+id/tvSetAsHomeScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfuitext_medium"
                android:includeFontPadding="false"
                android:text="@string/lc_set_as_home_screen"
                android:textColor="@color/lc_black"
                android:textSize="16sp" />

            <TextView
                android:paddingHorizontal="20dp"
                android:id="@+id/tvSetAsBoth"
                android:paddingVertical="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfuitext_medium"
                android:includeFontPadding="false"
                android:text="@string/lc_set_as_both"
                android:textColor="@color/lc_black"
                android:textSize="16sp" />


        </LinearLayout>


    </androidx.cardview.widget.CardView>

</LinearLayout>