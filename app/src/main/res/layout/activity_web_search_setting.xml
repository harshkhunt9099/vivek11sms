<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_app_bg"
    android:orientation="vertical"
    tools:context=".launcher.Codebizz_All_Activity.Codebizz_WebSearchSettingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:padding="5dp"
            android:src="@drawable/lc_ic_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            android:fontFamily="@font/sfuitext_medium"
            android:includeFontPadding="false"
            android:text="@string/lc_search"
            android:textColor="@color/lc_txt_color"
            android:textSize="18sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lc_black_5" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="15dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/sfuitext_medium"
                android:includeFontPadding="false"
                android:text="@string/lc_preview"
                android:textColor="@color/lc_hover_color"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/lc_img_search_preview" />

            <LinearLayout
                android:id="@+id/llSearchEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sfuitext_medium"
                    android:includeFontPadding="false"
                    android:text="@string/lc_search_engine"
                    android:textColor="@color/lc_txt_color"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSearchEngineName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/sfuitext_regular"
                    android:includeFontPadding="false"
                    android:text="@string/lc_google_default"
                    android:textColor="#979595"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:fontFamily="@font/sfuitext_medium"
                android:includeFontPadding="false"
                android:text="@string/lc_search_bar"
                android:textColor="@color/lc_hover_color"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/lc_bg_home_screen_setting_item"
                android:orientation="horizontal"
                android:padding="15dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_search"
                    app:tint="@color/lc_ic_color" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sfuitext_medium"
                    android:includeFontPadding="false"
                    android:text="@string/lc_drawer_search_bar"
                    android:textColor="@color/lc_txt_color"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchDrawerSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:thumb="@drawable/lc_switch_custom_thumb_launcher_setting"
                    android:track="@drawable/lc_switch_custom_track_launcher_setting"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/lc_bg_home_screen_setting_item"
                android:orientation="horizontal"
                android:padding="15dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    app:tint="@color/lc_ic_color"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_keyboard"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/sfuitext_medium"
                        android:includeFontPadding="false"
                        android:text="@string/lc_auto_open_keyboard"
                        android:textColor="@color/lc_txt_color"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/sfuitext_regular"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:text="@string/lc_show_the_keyboard_automatically_when_opening_the_drawer_with_the_search_bar"
                        android:textColor="#979595"
                        android:textSize="11sp" />


                </LinearLayout>

                <Switch
                    android:id="@+id/switchAutoOpenKeyboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:thumb="@drawable/lc_switch_custom_thumb_launcher_setting"
                    android:track="@drawable/lc_switch_custom_track_launcher_setting"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/lc_bg_home_screen_setting_item"
                android:orientation="horizontal"
                android:padding="15dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_close_drawer_on_app_launch" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/sfuitext_medium"
                        android:includeFontPadding="false"
                        android:text="Close Drawer On Opening App"
                        android:textColor="@color/lc_txt_color"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/sfuitext_regular"
                        android:includeFontPadding="false"
                        android:text="Automatically keeps the navigation drawer closed when the app is launched"
                        android:textColor="#979595"
                        android:textSize="11sp" />


                </LinearLayout>

                <Switch
                    android:id="@+id/switchCloseDrawer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:thumb="@drawable/lc_switch_custom_thumb_launcher_setting"
                    android:track="@drawable/lc_switch_custom_track_launcher_setting"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="15dp"
                android:background="@drawable/lc_bg_home_screen_setting_item"
                android:orientation="horizontal"
                android:padding="15dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    app:tint="@color/lc_ic_color"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/lc_ic_app_suggestions" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sfuitext_medium"
                    android:includeFontPadding="false"
                    android:text="@string/lc_app_suggestions"
                    android:textColor="@color/lc_txt_color"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchAppSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:thumb="@drawable/lc_switch_custom_thumb_launcher_setting"
                    android:track="@drawable/lc_switch_custom_track_launcher_setting"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

            </LinearLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/nativeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp" />

</LinearLayout>