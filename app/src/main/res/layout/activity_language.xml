<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_app_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:padding="5dp"
            android:src="@drawable/lc_ic_back"
            app:tint="@color/lc_ic_color" />

        <TextView
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            android:fontFamily="@font/sfuitext_medium"
            android:includeFontPadding="false"
            android:text="@string/lc_select_language"
            android:textColor="@color/lc_txt_color"
            android:textSize="18sp" />

        <TextView
            android:gravity="center"
            android:id="@+id/btnDone"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/_23sdp"
            android:fontFamily="@font/sfuitext_medium"
            android:includeFontPadding="false"
            android:background="@drawable/done_bg_border"
            android:text="✓"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="@dimen/_15sdp"
            app:cornerRadius="50dp" />

    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLanguage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingBottom="10dp"
        tools:listitem="@layout/item_language"/>

    <FrameLayout
        android:layout_marginHorizontal="@dimen/_5sdp"
        android:id="@+id/nativeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp" />

</LinearLayout>