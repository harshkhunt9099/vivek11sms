<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Main Card -->
    <RelativeLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:layout_above="@+id/nativeContainer"
            android:id="@+id/a"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:adjustViewBounds="true"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:src="@drawable/back"/>

                <!-- Title -->
                <LinearLayout
                    android:id="@+id/tp"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Personalized Information"
                        android:textColor="#000"
                        android:textSize="@dimen/_14sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center"
                        android:fontFamily="@font/dm_re"
                        android:text="Help us personalize your video download experience\nwith content suited for you"
                        android:textColor="#3B93FF"
                        android:textSize="@dimen/_10sdp" />

                    <!-- Gender Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="60dp"
                            android:layout_height="1dp"
                            android:background="#999999" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:text="•  Select Gender  •"
                            android:textColor="#000"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="@dimen/_12sdp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="60dp"
                            android:layout_height="1dp"
                            android:background="#999999" />
                    </LinearLayout>

                    <!-- Gender Layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!-- Female -->
                        <RelativeLayout
                            android:paddingVertical="@dimen/_8sdp"
                            android:id="@+id/layoutFemale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_gender_selected"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_centerVertical="true"
                                android:id="@+id/tvFemale"
                                android:layout_marginLeft="@dimen/_25sdp"
                                android:textStyle="bold"
                                android:fontFamily="@font/pt_regular"
                                android:textSize="@dimen/_14sdp"
                                android:textColor="@android:color/white"
                                android:text="Female"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <ImageView
                                android:layout_marginRight="@dimen/_10sdp"
                                android:layout_alignParentRight="true"
                                android:adjustViewBounds="true"
                                android:src="@drawable/female"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"/>


                        </RelativeLayout>


                        <!-- Space -->
                        <Space
                            android:layout_width="50dp"
                            android:layout_height="wrap_content" />

                        <RelativeLayout
                            android:layout_marginTop="@dimen/_10sdp"
                            android:id="@+id/layoutMale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/_8sdp"
                            android:background="@drawable/bg_gender_unselected"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMale"
                                android:layout_marginLeft="@dimen/_25sdp"
                                android:textStyle="bold"
                                android:fontFamily="@font/pt_regular"
                                android:textSize="@dimen/_14sdp"
                                android:textColor="@color/black"
                                android:text="Male"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <ImageView
                                android:layout_marginRight="@dimen/_10sdp"
                                android:layout_alignParentRight="true"
                                android:adjustViewBounds="true"
                                android:src="@drawable/male"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"/>

                        </RelativeLayout>



                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginBottom="@dimen/_50sdp"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/select_border_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_warning"
                            app:tint="#3B93FF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Once you select you gender, it cannot be changed!
Make sure to choose carefully before proceeding."
                            android:textColor="#000"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>
        </ScrollView>
        <FrameLayout
            android:layout_above="@+id/next"
            android:id="@+id/nativeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp" />


        <ImageView
            android:layout_marginTop="@dimen/_10sdp"
            android:id="@+id/next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:adjustViewBounds="true"
            android:src="@drawable/next" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>