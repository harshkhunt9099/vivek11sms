<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    android:layout_centerInParent="true"
    android:background="@drawable/lc_bg_dialog"
    android:gravity="center"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:textDirection="ltr">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_container_native"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="@color/native_shimmer_color">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center|top"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/iconView"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="6dp"
                    android:adjustViewBounds="true"
                    android:background="@color/dark_grey_ad"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#f4b400"
                            android:layout_gravity="center"
                            android:background="@drawable/lc_g_rounded_corners_shape_custom"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="2dp"
                            android:text="AD"
                            android:textColor="@color/gnt_white"
                            android:textSize="11sp" />


                        <TextView
                            android:id="@+id/headlineView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:background="@color/dark_grey_ad"
                            android:maxLines="1"
                            android:textColor="@color/adPrimaryTxtColor"
                            android:textSize="15sp"
                            app:fontFamily="@font/sfuitext_semibold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/bodyView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:background="@color/dark_grey_ad"
                        android:minLines="2"
                        android:textColor="@color/adPrimaryTxtColor"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mediaView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@color/dark_grey_ad" />

            <LinearLayout
                android:id="@+id/line4"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="10dp"
                android:background="@color/dark_grey_ad" />


        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

</LinearLayout>