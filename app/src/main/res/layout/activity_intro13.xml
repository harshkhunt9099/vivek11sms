<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:adjustViewBounds="true"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:src="@drawable/back"/>

        <ScrollView
            android:layout_above="@+id/tp"
            android:layout_below="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_200sdp">

            <LinearLayout
                android:layout_marginBottom="@dimen/_50sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:orientation="vertical">
                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Select Category"
                    android:textColor="#000"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold" />

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/pt_regular"

                    android:gravity="center"
                    android:text="Select category to discover people or content that\nsuits you best"
                    android:textColor="#3B93FF"
                    android:textSize="@dimen/_10sdp" />

                <!-- Instagram -->
                <LinearLayout
                    android:id="@+id/layoutInsta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:background="@drawable/bg_gender_selected"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:id="@+id/tvInsta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pt_regular"
                        android:text="Insta Download"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

                <!-- TikTok -->
                <LinearLayout
                    android:id="@+id/layoutTikTok"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_gender_unselected"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvTikTok"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pt_regular"
                        android:text="Tik Tok Download"
                        android:textColor="#000"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

                <!-- Facebook -->
                <LinearLayout
                    android:id="@+id/layoutFacebook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_gender_unselected"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvFacebook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pt_regular"
                        android:text="Facebook Download"
                        android:textColor="#000"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

                <!-- Twitter -->
                <LinearLayout
                    android:id="@+id/layoutTwitter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_gender_unselected"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvTwitter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pt_regular"
                        android:text="Twitter Download"
                        android:textColor="#000"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

                <!-- Mitron -->
                <LinearLayout
                    android:id="@+id/layoutMitron"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_gender_unselected"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvMitron"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pt_regular"
                        android:text="Mitron Download"
                        android:textColor="#000"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

                <!-- All Video -->
                <LinearLayout
                    android:layout_marginBottom="@dimen/_50sdp"
                    android:id="@+id/layoutAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="14dp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_gender_unselected"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tvAll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/pt_regular"
                        android:text="HD Video Downloader"
                        android:textColor="#000"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <RelativeLayout
            android:gravity="bottom"
            android:id="@+id/tp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/next">

            <FrameLayout
                android:id="@+id/nativeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

        </RelativeLayout>

        <!-- Next Button -->
        <ImageView
            android:id="@+id/next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="@dimen/_10sdp"
            android:adjustViewBounds="true"
            android:src="@drawable/next" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>