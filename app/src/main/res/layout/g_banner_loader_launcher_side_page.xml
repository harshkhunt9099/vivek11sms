<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_banner_shimmer"
    android:layout_centerInParent="true"
    android:background="#21FFFFFF"
    android:gravity="center"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:textDirection="ltr">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_container_native"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="@color/native_shimmer_color">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/lightTransparent"
                android:orientation="vertical"
                android:paddingTop="5dip"
                android:paddingBottom="5.0dip" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_5sdp"
                android:background="@drawable/lc_g_rounded_corners_shape_custom"
                android:backgroundTint="#f4b400"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="AD"
                android:textColor="@color/gnt_white"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_toStartOf="@+id/cta_loader"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="5dp"
                android:layout_toEndOf="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headlineView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/dark_grey_ad"
                    android:maxLines="1"
                    android:textColor="@color/adPrimaryTxtColor"
                    android:textSize="15sp"
                    app:fontFamily="@font/sfuitext_semibold" />

                <TextView
                    android:id="@+id/bodyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@color/dark_grey_ad"
                    android:minLines="2"
                    android:textColor="@color/adPrimaryTxtColor"
                    android:textSize="11sp" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cta_loader"
                android:layout_alignParentEnd="true"
                android:layout_width="100dp"
                android:layout_marginEnd="5dp"
                android:layout_centerVertical="true"
                android:layout_height="38dp"
                android:background="@drawable/lc_bg_main_cta_btn"
                android:gravity="center"
                android:lines="1"
                android:textColor="@color/gnt_white" />

        </RelativeLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</LinearLayout>

