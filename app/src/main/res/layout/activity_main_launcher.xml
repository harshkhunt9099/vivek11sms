<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/home_screen_grid"
        layout="@layout/home_screen_grid" />

    <include
        android:id="@+id/all_apps_fragment"
        layout="@layout/fragment_all_apps"
        android:visibility="gone" />

    <include
        android:id="@+id/widgets_fragment"
        layout="@layout/fragment_widgets"
        android:visibility="gone" />

    <include
        android:id="@+id/right_side_fragment"
        layout="@layout/fragment_right_side"
        android:visibility="gone" />

    <View
        android:id="@+id/home_screen_popup_menu_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/ivSwipeHintre"
        android:background="#CCFFFFFF"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivSwipeHint"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:adjustViewBounds="true"
            android:layout_gravity="center"
            app:tint="@color/white" />
        <ImageView
            android:id="@+id/ivSwipeHint1"
            android:visibility="gone"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:adjustViewBounds="true"
            android:layout_gravity="center"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/ivSwipeHinttext"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:fontFamily="@font/sfuitext_medium"
            android:layout_centerHorizontal="true"
            android:textColor="#000000"
            android:textSize="@dimen/_15sdp"
            android:textAlignment="center"
            android:layout_below="@+id/ivSwipeHint"
            android:text="@string/swipe_right_to_scan_all_video_downloader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</RelativeLayout>
