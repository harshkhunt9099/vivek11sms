<LinearLayout android:id="@+id/llSetDefaultLauncher"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:background="@color/lc_search_bar_background"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginStart="10dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/logo_round" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:fontFamily="@font/sfuitext_medium"
        android:includeFontPadding="false"
        android:text="@string/lc_set_message_to_your_default_home_app"
        android:textColor="@color/lc_txt_color"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetNow"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:layout_marginEnd="10dp"
        android:backgroundTint="@color/lc_hover_color"
        android:fontFamily="@font/sfuitext_medium"
        android:includeFontPadding="false"
        android:text="@string/lc_set_now"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="50dp" />

</LinearLayout>
