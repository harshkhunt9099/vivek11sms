<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />


    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>



    <!-- SMS & MMS Permissions (Required for Default SMS App Role) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />


    <!-- Incoming message notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />



    <application
        android:name=".PANDA_ads.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/logo_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">




        <activity
            android:name=".SettingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.AllVideoDownloaderHome" />
        <activity
            android:name=".Intro.SMS__Splash_Screen"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Intro.SMS__intro_1"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.AllVideoDownloaderHome" />
        <activity
            android:name=".Intro.SMS_intro_3"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.AllVideoDownloaderHome" />
        <activity
            android:name=".Intro.intro_1_3"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.AllVideoDownloaderHome" />
        <activity
            android:name=".Intro.SMS_intro_4"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.AllVideoDownloaderHome" />
        <activity
            android:name=".Intro.SMS__intro_5"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.AllVideoDownloaderHome" />
        <activity
            android:name=".Intro.SMS__intro_6"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.AllVideoDownloaderHome" />
        <activity
            android:name=".PANDA_Activity.SetWallpaperActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_Activity.WallpaperListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_Activity.Spidy_LanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_Activity.MainLauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/LauncherTheme">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PANDA_Activity.SetDefaultLauncherActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_ads.CustomTabActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Transparent" />
        <activity
            android:name=".PANDA_Activity.Spidy_LauncherSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_Activity.Spidy_GesturesSettingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_Activity.WebSearchSettingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_Activity.Spidy_AppDrawerSettingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_Activity.Spidy_HomeScreenSettingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PANDA_Activity.WebSearchActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Intro.SMS_intro_2"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.AllVideoDownloaderHome" />
        <activity
            android:name=".PANDA_Activity.Spidy_MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>




        <!--SMS SMSMSMSMSMSMSMSMSSMSSM -->
        <activity
            android:name=".PANDA_text.activity.DefaultSmsActivity"
            android:exported="false" />


        <activity
            android:name=".PANDA_text.activity.ChatActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Required so this app can be offered as the handler for sms: / mms: links,
                 one of the conditions Android checks before letting a user set it as
                 their default SMS app. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PANDA_text.activity.NewChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PANDA_text.activity.SettingsActivity"
            android:exported="false" />

        <!-- Receives incoming SMS while this app is the default SMS app -->
        <receiver
            android:name=".PANDA_text.receiver.MessageReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Receives incoming MMS while this app is the default SMS app -->
        <receiver
            android:name=".PANDA_text.receiver.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Lets other apps (e.g. Assistant "reply to last message") send a quick reply
             without opening the UI. Required for default-SMS-app eligibility. -->
        <service
            android:name=".PANDA_text.service.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" /> <!-- TODO REPLACE WITH YOUR ACTUAL ID -->
        <!-- Facebook Marketing Code Start -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="example" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="example" />
    </application>

</manifest>