<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:background="@drawable/pm_native_ad_bg"
    android:fitsSystemWindows="false"
    android:gravity="center"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:textDirection="ltr">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_container_native"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1.2:1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="@color/pm_native_shimmer_color">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/pm_lightTransparent"
                android:orientation="vertical"
                android:paddingTop="5dip"
                android:paddingBottom="5.0dip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="7dp"
                android:background="@drawable/pm_sponsor_bg_loader"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="Ad"
                android:textColor="@color/pm_black"
                android:textSize="12sp" />
        </RelativeLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>