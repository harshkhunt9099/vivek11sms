<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="@color/pm_white"
    android:layout_height="match_parent"
    tools:context=".Codebizz_activity.Codebizz_PackageMonitorDisableConfirmationActivity">

    <RelativeLayout
        android:id="@+id/mainRel"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:padding="5dp"
            android:src="@drawable/pm_main_back" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="15dp"
            android:layout_toEndOf="@+id/imgBack"
            android:fontFamily="@font/sf_ui_text_medium"
            android:includeFontPadding="false"
            android:text="@string/pm_disable_install_scan"
            android:textColor="@color/pm_black"
            android:textSize="20sp" />

    </RelativeLayout>

    <View
        android:id="@+id/main_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/pm_line_color" />

    <androidx.core.widget.NestedScrollView
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="15dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/sf_ui_text_medium"
                android:includeFontPadding="false"
                android:text="@string/pm_install_and_uninstall_monitoring_to_stay_informed_about_changes_on_your_device"
                android:textColor="@color/pm_black"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/sf_ui_text_regular"
                android:includeFontPadding="false"
                android:text="@string/pm_get_instant_alerts_when_apps_are_added_or_removed_and_automatically_scan_for_junk_files_to_keep_your_storage_clean_and_optimized"
                android:textColor="@color/pm_black"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="20dp"
                app:cardBackgroundColor="#FBFBFB"
                android:id="@+id/cvUninstallScan"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="#0D000000"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSwitchTitle"
                        android:layout_marginHorizontal="15dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_ui_text_medium"
                        android:includeFontPadding="false"
                        android:text="@string/pm_title_package_install_scan"
                        android:textColor="@color/pm_black"
                        android:textSize="18sp" />

                    <Switch
                        android:id="@+id/switchStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="15dp"
                        android:checked="true"
                        android:background="@android:color/transparent"
                        android:thumb="@drawable/pm_switch_custom_thumb_launcher_setting"
                        android:track="@drawable/pm_switch_custom_track_launcher_setting"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/nativeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
         />

</LinearLayout>